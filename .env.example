# Salin ke .env lalu isi dengan nilai lokalmu. JANGAN commit .env.
# Generate JWT_ACCESS_SECRET & JWT_REFRESH_SECRET dengan:
#   pwsh -NoProfile -Command "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))"

# --- Database (dev) ---
DATABASE_URL=postgres://trackpoint:GANTI_PASSWORD@localhost:5432/trackpoint?sslmode=disable
# Hanya dipakai cmd/dbsetup (koneksi superuser lokal, bukan kredensial aplikasi)
DB_SUPERUSER_URL=postgres://postgres:GANTI_PASSWORD@localhost:5432/postgres?sslmode=disable
DB_NAME=trackpoint
DB_TEST_NAME=trackpoint_test

# --- JWT / session ---
JWT_ACCESS_SECRET=GANTI_DENGAN_BASE64_ACAK_MINIMAL_48_BYTE
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# --- Server ---
PORT=8080
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false